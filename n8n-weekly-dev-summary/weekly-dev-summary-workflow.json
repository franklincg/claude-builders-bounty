{
  "name": "Weekly GitHub Dev Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [5],
              "triggerAtHour": 17
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Friday 17:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "repo", "name": "repo", "value": "owner/repo", "type": "string"},
            {"id": "language", "name": "language", "value": "EN", "type": "string"},
            {"id": "destination", "name": "discordWebhook", "value": "https://discord.com/api/webhooks/REPLACE", "type": "string"}
          ]
        }
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const [owner,repo] = $json.repo.split('/'); const since = new Date(Date.now()-7*86400000).toISOString(); return [{json:{...$json,owner,repo,since}}];"
      },
      "id": "window",
      "name": "Build Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/graphql",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{$env.GITHUB_TOKEN}}"},
            {"name": "User-Agent", "value": "n8n-weekly-dev-summary"}
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"query\":\"query($owner:String!,$repo:String!){repository(owner:$owner,name:$repo){defaultBranchRef{target{... on Commit{history(first:50){nodes{oid messageHeadline committedDate author{name}}}}}} issues(first:50,states:CLOSED,orderBy:{field:UPDATED_AT,direction:DESC}){nodes{number title closedAt url}} pullRequests(first:50,states:MERGED,orderBy:{field:UPDATED_AT,direction:DESC}){nodes{number title mergedAt url}}}}\",\"variables\":{\"owner\":\"{{$json.owner}}\",\"repo\":\"{{$json.repo}}\"}}"
      },
      "id": "github",
      "name": "GitHub Activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "jsCode": "const data=$json.data?.repository||{}; const since=new Date(Date.now()-7*86400000); const commits=(data.defaultBranchRef?.target?.history?.nodes||[]).filter(x=>new Date(x.committedDate)>=since); const issues=(data.issues?.nodes||[]).filter(x=>x.closedAt&&new Date(x.closedAt)>=since); const prs=(data.pullRequests?.nodes||[]).filter(x=>x.mergedAt&&new Date(x.mergedAt)>=since); const lang=$('Config').first().json.language||'EN'; const prompt=`Write a concise weekly developer narrative in ${lang}. Commits: ${JSON.stringify(commits)} Closed issues: ${JSON.stringify(issues)} Merged PRs: ${JSON.stringify(prs)}`; return [{json:{prompt,commits,issues,prs}}];"
      },
      "id": "prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "x-api-key", "value": "={{$env.ANTHROPIC_API_KEY}}"},
            {"name": "anthropic-version", "value": "2023-06-01"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"model\":\"claude-sonnet-4-20250514\",\"max_tokens\":1200,\"messages\":[{\"role\":\"user\",\"content\":{{$json.prompt.toJsonString()}}}]}"
      },
      "id": "claude",
      "name": "Claude Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$(\"Config\").first().json.discordWebhook}}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"content\":{{$json.content[0].text.toJsonString()}}}"
      },
      "id": "discord",
      "name": "Discord Delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0]
    }
  ],
  "connections": {
    "Friday 17:00": {"main": [[{"node": "Config", "type": "main", "index": 0}]]},
    "Config": {"main": [[{"node": "Build Window", "type": "main", "index": 0}]]},
    "Build Window": {"main": [[{"node": "GitHub Activity", "type": "main", "index": 0}]]},
    "GitHub Activity": {"main": [[{"node": "Build Prompt", "type": "main", "index": 0}]]},
    "Build Prompt": {"main": [[{"node": "Claude Summary", "type": "main", "index": 0}]]},
    "Claude Summary": {"main": [[{"node": "Discord Delivery", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {}
}
